# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In production, set the same variables in Vercel -> Project -> Settings -> Environment Variables.
# NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# --- App -------------------------------------------------------------------
# Public base URL of the app, used for auth redirects and links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Phase 1) ------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key. Safe in the browser because RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key. BYPASSES RLS: server only, never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend email (Phase 4) ----------------------------------------------------
# resend.com -> API Keys.
RESEND_API_KEY=
# Sender address on your verified domain, e.g. "Elev8ai <notifications@yourdomain.com>".
EMAIL_FROM=

# --- Lemon Squeezy course payments (Phase 5) -----------------------------------
# Settings -> API. Used to create checkout links.
LEMONSQUEEZY_API_KEY=
# Settings -> Stores -> your store's numeric ID.
LEMONSQUEEZY_STORE_ID=
# Settings -> Webhooks -> signing secret you choose; verifies /api/webhooks/lemonsqueezy.
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Bunny Stream course video (Phase 5) ---------------------------------------
# Stream -> your Video Library -> API.
BUNNY_STREAM_LIBRARY_ID=
# Library API key (for managing videos from the server).
BUNNY_STREAM_API_KEY=
# Security -> Token Authentication key. Signs expiring embed URLs so only buyers can watch.
BUNNY_STREAM_TOKEN_KEY=

# --- Monitoring and analytics (Phase 7) ----------------------------------------
# Sentry project DSN (public by design).
NEXT_PUBLIC_SENTRY_DSN=
# PostHog project API key and host (e.g. https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
